{% extends 'base.html.twig' %} {% block title %}Hello EventController!{%
endblock %} {% block body %}
<div class="w-full mt-10">
  {% for event in events %}
  <div class="w-full mb-4 border-b border-gray-400 pb-4">
    <h2 class="text-2xl font-bold mb-4">{{event.id}}. {{ event.title }}</h2>
    <p>{{ event.description }}</p>
    <div class="w-full mt-4 flex justify-start gap-4">
      <a
      href="{{ path('admin_event_edit', { id: event.id }) }}"
      class="py-8 font-bold text-blue-800 hover:text-blue-400 transition ease-in-out duration-300"
      >Editar</a
    >
     <a
      href="{{ path('admin_event_remove', { id: event.id }) }}"
      class="py-8 font-bold text-red-800 hover:text-red-400 transition ease-in-out duration-300"
      >Remover</a
    >
    </div>
  </div>
  {% endfor %}
</div>
{% endblock %}
