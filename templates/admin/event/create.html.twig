{% extends 'base.html.twig' %} {% block title %}Hello EventController!{%endblock
%} {% block body %}

<div class="w-full mt-10">
  <div class="w-full mb-8">
    <a href="{{ path('admin_event_index') }}" class="underline text-bold"
      >Eventos</a
    >
    &raquo; Criar Evento
  </div>
  <div class="w-full mb-10 flex justify-between">
    <h2 class="text-2xl font-bold">
      <small>Criar Evento</small>
    </h2>
  </div>
  <form action="{{path('admin_event_store')}}" method="POST" >
  <div class="w-full">
    <label for="" class="mb-6 block">Titulo</label>
    <input
      type="text"
      name="event[title]"
      class="w-full rounded border border-gray-400 p-2 mb-6"
    />
  </div>

  <div class="w-full">
    <label for="" class="mb-6 block">Descrição</label>
    <input
      type="text"
      name="event[description]"
      class="w-full rounded border border-gray-400 p-2 mb-6"
    />
  </div>

  <div class="w-full">
    <label for="" class="mb-6 block">Conteúdo</label>
    <textarea
      name="event[body]"
      class="w-full rounded border border-gray-400 p-2 mb-6"
    ></textarea>
  </div>

  <div class="w-full">
    <label for="" class="mb-6 block">Inicio do Evento</label>
    <input
      type="text"
      name="event[start_date]"
      class="w-full rounded border border-gray-400 p-2 mb-6"
    />
  </div>

  <div class="w-full">
    <label for="" class="mb-6 block">Fim do Evento</label>
    <input
      type="text"
      name="event[end_date]"
      class="w-full rounded border border-gray-400 p-2 mb-6"
    />
  </div>

  <button class="px-4 py-2 text-2xl rounded bg-green-600 text-white border-green-900 font-thin hover:bg-green-900 transition ease-in-out duration-300">Criar</button>
  </form>
</div>

{% endblock %}
