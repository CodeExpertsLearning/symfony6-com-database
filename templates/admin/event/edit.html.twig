{% extends 'base.html.twig' %} {% block title %}Hello EventController!{%endblock
%} {% block body %}

<div class="w-full mt-10">
  <div class="w-full mb-8">
    <a href="{{ path('admin_event_index') }}" class="underline text-bold"
      >Eventos</a
    >
    &raquo; Editar Evento
  </div>
  <div class="w-full mb-10 flex justify-between">
    <h2 class="text-2xl font-bold">
      <small>Editar Evento: </small>{{ event.title }}
    </h2>
  </div>

  <form action="{{path('admin_event_update', {id: event.id})}}" method="POST" >
    <div class="w-full">
        <label for="" class="mb-6 block">Titulo</label>
        <input
          type="text"
          name="event[title]"
          class="w-full rounded border border-gray-400 p-2 mb-6"
          value="{{ event.title }}"
        />
      </div>

      <div class="w-full">
        <label for="" class="mb-6 block">Descrição</label>
        <input
          type="text"
          name="event[description]"
          class="w-full rounded border border-gray-400 p-2 mb-6"
          value="{{ event.description }}"
        />
      </div>

      <div class="w-full">
        <label for="" class="mb-6 block">Conteúdo</label>
        <textarea
          name="event[body]"
          class="w-full rounded border border-gray-400 p-2 mb-6"
        >{{ event.body }}</textarea>
      </div>

      <div class="w-full">
        <label for="" class="mb-6 block">Inicio do Evento</label>
        <input
          type="text"
          name="event[start_date]"
          class="w-full rounded border border-gray-400 p-2 mb-6"
          value="{{ event.startDate|date('d/m/Y H:i:s') }}"
        />
      </div>

      <div class="w-full">
        <label for="" class="mb-6 block">Fim do Evento</label>
        <input
          type="text"
          name="event[end_date]"
          class="w-full rounded border border-gray-400 p-2 mb-6"
          value="{{ event.endDate|date('d/m/Y H:i:s') }}"
        />
      </div>

      <button class="px-4 py-2 text-2xl rounded bg-green-600 text-white border-green-900 font-thin hover:bg-green-900 transition ease-in-out duration-300">Editar</button>
    </form>
</div>

{% endblock %}
